#!/usr/bin/env bash
# 4ndr0666
## Autostart Programs ---------------------------------------

set -Eeuo pipefail

USER_SCRIPTS="$HOME/.config/hypr/UserScripts"

# Apply GTK themes
if [[ -x "$USER_SCRIPTS/gtkthemes" ]]; then
	"$USER_SCRIPTS/gtkthemes" &
fi

# Initialize portals, awww-daemon, and waybar via canonical initializer
if [[ -x "$USER_SCRIPTS/4ndr0init.sh" ]]; then
	"$USER_SCRIPTS/4ndr0init.sh"
fi

# Start notification daemon (swaync) if not running
if command -v swaync >/dev/null 2>&1 && ! pidof swaync >/dev/null 2>&1; then
	swaync &
fi

# Start network manager applet if available
if command -v nm-applet >/dev/null 2>&1 && ! pidof nm-applet >/dev/null 2>&1; then
	nm-applet --indicator &
fi
